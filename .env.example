# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored — never commit a real key.

# Required: your OpenRouter key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: any OpenRouter model id (default: anthropic/claude-haiku-4.5)
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional: port for the local server (default: 3000)
PORT=3000

# Optional: public site address, sent to OpenRouter for attribution
SITE_URL=http://localhost:3000
